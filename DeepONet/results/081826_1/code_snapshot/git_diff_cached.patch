+   "source": [
+    "ROOT_DIR = Path(\"/home/hantianl/Documents/PIDIF/\")\n",
+    "\n",
+    "# Multi-scale case pool. All channels are 1 mm long; the nominal height differs\n",
+    "# per group (inlet velocity is 1 m/s everywhere, so Re = U*H/nu differs too):\n",
+    "#   channel_water          channel_00..channel_09   H = 0.10 mm (AR 10, Re ~ 100)\n",
+    "#   channel_water_ablation channel_020..channel_029 H = 0.20 mm (AR 5,  Re ~ 200)\n",
+    "#   channel_water_ablation channel_030..channel_039 H = 0.05 mm (AR 20, Re ~ 50)\n",
+    "CASE_DATASET = {}\n",
+    "CASE_DATASET.update({f\"channel_{i:02d}\": \"channel_water\" for i in range(10)})\n",
+    "CASE_DATASET.update({f\"channel_{i:03d}\": \"channel_water_ablation\" for i in range(20, 40)})\n",
+    "\n",
+    "def case_paths(ch):\n",
+    "    ds = CASE_DATASET[ch]\n",
+    "    return {\n",
+    "        \"design\": ROOT_DIR / f\"2d_geometry_specs/{ds}/{ch}.json\",\n",
+    "        \"mesh\": ROOT_DIR / f\"runs_2d/{ds}/{ch}/{ch}.msh.h5\",\n",
+    "        \"dat\": ROOT_DIR / f\"runs_2d/{ds}/{ch}/case2d.dat.h5\",\n",
+    "    }\n",
+    "\n",
+    "# Keep only cases whose design/mesh/dat files all exist (completed runs).\n",
+    "available_cases = [\n",
+    "    ch for ch in CASE_DATASET\n",
+    "    if all(case_paths(ch)[k].exists() for k in (\"design\", \"mesh\", \"dat\"))\n",
+    "]\n",
+    "case_files = {ch: case_paths(ch) for ch in available_cases}\n",
+    "\n",
+    "print(f\"Available cases ({len(available_cases)}):\")\n",
+    "for ds in (\"channel_water\", \"channel_water_ablation\"):\n",
+    "    print(f\"  {ds}:\", sorted(ch for ch in available_cases if CASE_DATASET[ch] == ds))"
+   ]
