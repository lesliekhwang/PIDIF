+    "        missing = sorted(set(group_cases) - set(cases))\n",
+    "        print(f\"WARNING: {group_name} is missing solved cases: {missing}\")\n",
+    "    shuffled = list(cases)\n",
+    "    _split_rng.shuffle(shuffled)\n",
+    "    n_tr = len(shuffled) - 2  # 8/1/1 for a 10-case group\n",
+    "    TRAIN_CASES += shuffled[:n_tr]\n",
+    "    VALID_CASES += shuffled[n_tr:n_tr + 1]\n",
+    "    TEST_CASES += shuffled[n_tr + 1:n_tr + 2]\n",
+    "    print(f\"{group_name}: train={sorted(shuffled[:n_tr])}\")\n",
+    "    print(f\"{group_name}: valid={shuffled[n_tr:n_tr + 1]} test={shuffled[n_tr + 1:n_tr + 2]}\")\n",
+    "\n",
+    "print(f\"\\nTrain cases ({len(TRAIN_CASES)}):\", sorted(TRAIN_CASES))\n",
+    "print(f\"Valid cases ({len(VALID_CASES)}):\", sorted(VALID_CASES))\n",
+    "print(f\"Test  cases ({len(TEST_CASES)}):\", sorted(TEST_CASES))\n",
+    "\n",
+    "# Interfaces at fixed locations; n_sub adapts to each channel's aspect ratio.\n",
