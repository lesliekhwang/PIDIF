+   ],
+   "source": [
+    "# Per-geometry-group 8/1/1 train/val/test split (split by case id within each\n",
+    "# height group so every scale is represented in every split).\n",
+    "SPLIT_SEED = 0\n",
+    "GROUPS = {\n",
+    "    \"H0.05mm\": [f\"channel_{i:03d}\" for i in range(30, 40)],\n",
+    "    \"H0.10mm\": [f\"channel_{i:02d}\" for i in range(10)],\n",
+    "    \"H0.20mm\": [f\"channel_{i:03d}\" for i in range(20, 30)],\n",
+    "}\n",
+    "\n",
+    "_split_rng = np.random.default_rng(SPLIT_SEED)\n",
+    "TRAIN_CASES, VALID_CASES, TEST_CASES = [], [], []\n",
+    "for group_name, group_cases in GROUPS.items():\n",
