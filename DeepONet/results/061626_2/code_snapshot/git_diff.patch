+            query=q_left,
+        )
+        dpdx_right = _edge_grad_from_queries(
+            model=model,
+            branch_batch=b,
+            query=q_right,
+        )
+
+        if dpdx_left.shape[0] != n_sub or dpdx_right.shape[0] != n_sub:
+            raise RuntimeError("Unexpected interface gradient prediction shape")
+        return dpdx_left, dpdx_right
